# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=mlops-project
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API Service Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
MCP_PORT=8080

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlops_db
POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=change_this_password

# Database URL (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Vector Database Configuration (ChromaDB)
# -----------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=embeddings

# -----------------------------------------------------------------------------
# Google Cloud Platform (GCP) Configuration
# -----------------------------------------------------------------------------
# Project settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Service Account (place JSON file OUTSIDE this repo)
# Path should be absolute or relative to parent directory
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# GCS Buckets
GCS_BUCKET_DATA=your-project-data-bucket
GCS_BUCKET_MODELS=your-project-models-bucket
GCS_BUCKET_ARTIFACTS=your-project-artifacts-bucket

# Vertex AI
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_STAGING_BUCKET=gs://your-project-vertex-staging

# Container Registry
GCR_REGISTRY=gcr.io/${GCP_PROJECT_ID}

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
MODEL_NAME=your-model-name
MODEL_VERSION=v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# ML Workflow Configuration
# -----------------------------------------------------------------------------
PIPELINE_ROOT=gs://your-project-vertex-staging/pipelines

# -----------------------------------------------------------------------------
# External APIs (if needed)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# HUGGINGFACE_TOKEN=hf_...

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Set to true to enable debug endpoints
ENABLE_DEBUG_ENDPOINTS=true

# -----------------------------------------------------------------------------
# Docker Compose Overrides (for local development)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=mlops-project
