server {
  listen 80;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Health check for the kubelet.
  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  # One entrance: the browser only talks to this origin, and nginx passes /api on, full path included.
  # A new connection per request, so a Service picks a pod each time instead of sticking to one.
  location /api/ {
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header Connection close;
  }

  # Hashed bundles: the name changes when the content does, so cache forever.
  # A missing asset is a real 404, never index.html (otherwise the browser gets HTML for a .js file).
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Everything else is a page: serve the file if it exists, otherwise index.html and let the router decide.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
