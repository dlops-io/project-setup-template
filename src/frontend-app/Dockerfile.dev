FROM node:24.22.1-bookworm-slim

# /app/node_modules is created owned by `node` so the named volume mounted there (see
# docker-shell.sh) starts out writable by that user instead of root.
RUN mkdir -p /app/node_modules && chown -R node:node /app

USER node
WORKDIR /app

# Vite dev server
EXPOSE 5173

# The script comes from the bind-mounted checkout: it installs dependencies, then opens bash.
ENTRYPOINT ["/bin/bash", "docker-entrypoint.dev.sh"]
